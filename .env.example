# Copy to .env (git-ignored). Everything here is optional for the local demo;
# the production override (docker-compose.prod.yml) REQUIRES the starred ones.

# --- environment -------------------------------------------------------------
# development (default): demo users seeded, development secrets tolerated.
# production: services refuse default/short secrets, insecure cookies, non-HTTPS origin.
APP_ENV=development

# --- secrets (* required in production, 32+ random characters each) ----------
# Generate with:  openssl rand -base64 48
TRIAGE_HMAC_SECRET=          # * signs the audit log and the evidence the agent returns
TRIAGE_INTERNAL_TOKEN=       # * shared by backend and agent-api (service-to-service auth)

# --- the web app ------------------------------------------------------------
ALLOWED_ORIGIN=http://localhost:5173     # * https://... in production: the frontend's origin
PUBLIC_BACKEND_URL=                       # * production only: https://... the browser uses for the API
FRONTEND_PORT=5173
BACKEND_PORT=4000
SESSION_TTL_HOURS=8
LOGIN_RATE_MAX=10                         # failed logins per IP+email per 15 min
ASSESS_RATE_PER_HOUR=30                   # assessments per user per hour (each costs several LLM calls)

# --- development conveniences (refused in production) ------------------------
SEED_DEMO_USERS=true                      # creates underwriter@demo.local and auditor@demo.local
DEMO_PASSWORD=                            # blank = a random one is printed once in the backend logs

# --- the model ---------------------------------------------------------------
TRIAGE_MODEL=ollama/qwen2.5:14b
TRIAGE_RAG=1
OLLAMA_API_BASE=http://host.docker.internal:11434
